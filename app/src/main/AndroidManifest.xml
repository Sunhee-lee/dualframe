<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <!--
      Package visibility for BottomActionBar. Identifying the gallery app needs
      three lookups, and every one of them is a query, so all three are filtered
      without these declarations: getLaunchIntentForPackage on the Samsung
      packages, resolveActivity on the APP_GALLERY intent, and resolveActivity
      on the ACTION_VIEW intent once it has been aimed at that package.

      Naming the package is what stops the system offering every installed video
      player; leaving the view intent implicit puts up a chooser instead of the
      clip. Starting the activity is not itself filtered — only finding out who
      to start is.

      Observed on Samsung the gallery already resolves without this block, OEM
      system apps commonly being exempt; these entries cover the devices where
      they are not.
    -->
    <queries>
        <package android:name="com.sec.android.gallery3d" />
        <package android:name="com.samsung.android.gallery" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_GALLERY" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>

    <application
        android:name="com.dualframe.DualFrameApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DualFrame">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name="com.dualframe.ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
