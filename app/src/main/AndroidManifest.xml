<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <!--
      Package visibility for BottomActionBar.buildGalleryIntent, which is the
      fallback used when nothing has been saved yet. Under targetSdk 30+ the
      queries it makes are filtered without these declarations:
      getLaunchIntentForPackage returns null for the Samsung packages, and
      resolveActivity returns null for the APP_GALLERY intent — collapsing the
      fallback to the video collection URI, i.e. a plain list instead of the
      gallery app. Starting an activity is never filtered, so the ACTION_VIEW
      that opens a saved item needs no entry here.
    -->
    <queries>
        <package android:name="com.sec.android.gallery3d" />
        <package android:name="com.samsung.android.gallery" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_GALLERY" />
        </intent>
    </queries>

    <application
        android:name="com.dualframe.DualFrameApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DualFrame">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name="com.dualframe.ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
